/* Display weapon damage. */
#LOOP {1} {&{items.weapons[]}} {index} {
	#LINE SUBSTITUTE variables {
		#SUB {${items.weapons[$index][item]}} {${items.weapons[$index][item]}$color[cyan] [${items.weapons[$index][damage]}]$color[reset]};
	};
	#UNVAR {index};
};
